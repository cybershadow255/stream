{
  "name": "stream-share-app",
  "version": "1.0.0",
  "description": "High performance 1080p/4K 60/120fps screen sharing and call desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [
    "webrtc",
    "screenshare",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.streamshare.app",
    "productName": "StreamShare",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    }
  }
}
